# =============================================================================
# G.PACK ERP 2.0 — Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# =============================================================================
# Database (Dokploy-managed PostgreSQL — use Internal Credentials)
# =============================================================================
DATABASE_HOST=your-postgres-host
DATABASE_PORT=5432
DATABASE_NAME=erp_gpack
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# Security
# =============================================================================
# JWT secret for authentication tokens (min 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Share token secret for encrypted public links (min 32 characters)
SHARE_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX_STRING

# =============================================================================
# Server
# =============================================================================
NODE_ENV=production
PORT=3000

# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info

# =============================================================================
# CORS & URLs
# =============================================================================
# CORS origin — your production domain
CORS_ORIGIN=https://erp.gpacksa.com

# Base URL for building public links (approvals, share tokens, etc.)
BASE_URL=https://erp.gpacksa.com

# Public base URL for manufacturer order share links (falls back to BASE_URL)
# PUBLIC_BASE_URL=https://erp.gpacksa.com

# =============================================================================
# AI Assistant (OpenAI-compatible — supports any provider)
# =============================================================================
# API key from your provider
OPENAI_API_KEY=your_api_key_here

# Model name (depends on your provider)
OPENAI_MODEL=gpt-4o-mini

# Base URL — change this to use a different provider:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Together AI: https://api.together.xyz/v1
#   Azure OpenAI: https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Enable/disable AI assistant
AI_ASSISTANT_ENABLED=true

# =============================================================================
# AI Forecasting Service (Python FastAPI microservice)
# =============================================================================
# URL of the ai-service container (for demand forecasting & RFM analysis)
AI_SERVICE_URL=http://ai-service:8000

# =============================================================================
# WhatsApp Integration (WAHA provider)
# =============================================================================
# Provider: waha (default), meta, twilio, green, evolution
WHATSAPP_PROVIDER=waha

# WAHA server URL
WAHA_URL=

# WAHA session name
WAHA_SESSION=default

# WAHA API key (if your WAHA instance requires authentication)
WAHA_API_KEY=

# Admin WhatsApp chat ID for fallback notifications (format: 9665XXXXXXXX@c.us)
WAHA_ADMIN_CHAT_ID=

# Webhook secret for verifying incoming WAHA webhook requests
WAHA_WEBHOOK_SECRET=

# WhatsApp number shown to clients on public design approval pages
WHATSAPP_NUMBER=

# =============================================================================
# Frontend Build
# =============================================================================
# Cache-buster for frontend Docker builds (increment to force rebuild)
CACHEBUST=1

# =============================================================================
# MCP Server (Model Context Protocol — AI-to-DB bridge)
# =============================================================================
# MCP server port (defaults to 3001)
# MCP_PORT=3001
